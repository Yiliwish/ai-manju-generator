# 只给本机 API 服务读取，不要提交真实 key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 如果账号暂不支持默认模型，可改成控制台中可用的模型名
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=sk-your-bailian-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
# 万相图生视频：需要百炼 WorkspaceId；也可以直接填写完整的 video API 基础地址
DASHSCOPE_WORKSPACE_ID=your-workspace-id
DASHSCOPE_VIDEO_MODEL=MiniMax/MiniMax-H3
# DASHSCOPE_VIDEO_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com
